; Named dinput8, but the same file also works when renamed to version.dll or xinput1_4.dll.
; xinput1_4 keeps its real ordinals (2-10, 100-109) because the game imports it by ordinal.
; dinput8 and version functions are imported by name, so their ordinals only need to be unique.
LIBRARY dinput8
EXPORTS
    ; xinput1_4
    XInputGetState              = Proxy_XInputGetState              @2
    XInputSetState              = Proxy_XInputSetState              @3
    XInputGetCapabilities       = Proxy_XInputGetCapabilities       @4
    XInputEnable                = Proxy_XInputEnable                @5
    XInputGetBatteryInformation = Proxy_XInputGetBatteryInformation @7
    XInputGetKeystroke          = Proxy_XInputGetKeystroke          @8
    XInputGetAudioDeviceIds     = Proxy_XInputGetAudioDeviceIds     @10
    Proxy_Ordinal100            @100 NONAME
    Proxy_Ordinal101            @101 NONAME
    Proxy_Ordinal102            @102 NONAME
    Proxy_Ordinal103            @103 NONAME
    Proxy_Ordinal104            @104 NONAME
    Proxy_Ordinal108            @108 NONAME
    Proxy_Ordinal109            @109 NONAME
    ; dinput8
    DirectInput8Create          = Proxy_DirectInput8Create          @200
    DllCanUnloadNow             = Proxy_DllCanUnloadNow             PRIVATE
    DllGetClassObject           = Proxy_DllGetClassObject           PRIVATE
    DllRegisterServer           = Proxy_DllRegisterServer           PRIVATE
    DllUnregisterServer         = Proxy_DllUnregisterServer         PRIVATE
    ; version
    GetFileVersionInfoA         = Proxy_GetFileVersionInfoA         @300
    GetFileVersionInfoByHandle  = Proxy_GetFileVersionInfoByHandle  @301
    GetFileVersionInfoExA       = Proxy_GetFileVersionInfoExA       @302
    GetFileVersionInfoExW       = Proxy_GetFileVersionInfoExW       @303
    GetFileVersionInfoSizeA     = Proxy_GetFileVersionInfoSizeA     @304
    GetFileVersionInfoSizeExA   = Proxy_GetFileVersionInfoSizeExA   @305
    GetFileVersionInfoSizeExW   = Proxy_GetFileVersionInfoSizeExW   @306
    GetFileVersionInfoSizeW     = Proxy_GetFileVersionInfoSizeW     @307
    GetFileVersionInfoW         = Proxy_GetFileVersionInfoW         @308
    VerFindFileA                = Proxy_VerFindFileA                @309
    VerFindFileW                = Proxy_VerFindFileW                @310
    VerInstallFileA             = Proxy_VerInstallFileA             @311
    VerInstallFileW             = Proxy_VerInstallFileW             @312
    VerLanguageNameA            = Proxy_VerLanguageNameA            @313
    VerLanguageNameW            = Proxy_VerLanguageNameW            @314
    VerQueryValueA              = Proxy_VerQueryValueA              @315
    VerQueryValueW              = Proxy_VerQueryValueW              @316
